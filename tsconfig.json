{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        /* ตั้งค่า Output */
        "outDir": "./dist",
        "rootDir": "./",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
